+        // --- Music Shop over HTTP ------------------------------------------------
+        // The launcher may expose the song catalogue through a plain HTTP server
+        // (O2JAM_SHOP_URL=http://host:port[/base]).  When it is set, the shop
+        // downloads from <url>/Patch/MUSIC/o2ma<ID>.ojn|.ojm instead of the
+        // original anonymous FTP/SFTP patch server, so songs can be served from
+        // a local directory, a NAS or any static web host.
+        struct ShopEndpoint
+        {
+            std::string Host;
+            unsigned short Port = 80;
+            std::string Base;
+        };
+
+        std::optional<ShopEndpoint> ResolveShopEndpoint(const CommandLineContext& args)
+        {
+            auto url = std::string();
+            if (const auto* env = std::getenv("O2JAM_SHOP_URL"); env != nullptr && *env != '\0')
+                url = env;
+            else if (const auto ftp = args.GetFtpUrl(); ftp.rfind("http://", 0) == 0)
+                url = ftp;
+
+            if (url.empty())
+                return std::nullopt;
+
+            if (url.rfind("http://", 0) == 0)
+                url = url.substr(7);
+
+            auto endpoint = ShopEndpoint();
+            const auto slash = url.find('/');
+            endpoint.Base = slash == std::string::npos ? std::string() : url.substr(slash);
+
+            const auto hostPort = url.substr(0, slash);
+            if (hostPort.empty())
+                return std::nullopt;
+
+            if (const auto colon = hostPort.rfind(':'); colon != std::string::npos)
+            {
+                endpoint.Host = hostPort.substr(0, colon);
+                try
+                {
+                    endpoint.Port = static_cast<unsigned short>(std::stoi(hostPort.substr(colon + 1)));
+                }
+                catch (...)
+                {
+                    return std::nullopt;
+                }
+            }
+            else
+                endpoint.Host = hostPort;
+
+            return endpoint.Host.empty() ? std::nullopt : std::optional<ShopEndpoint>(endpoint);
+        }

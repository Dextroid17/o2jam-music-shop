+    // Download a batch of songs from a static HTTP Music Shop (see ResolveShopEndpoint).
+    // Layout expected on the server: <base>/Patch/MUSIC/o2ma<ID>[_<version>].ojn and
+    // <base>/Patch/MUSIC/o2ma<ID>.ojm — the same paths the original patch server used.
+    void MusicDownloaderService::DownloadProcHttp(const std::vector<DownloadItem>& items, const std::string& host, const unsigned short port, const std::string& base)
+    {
+        auto http = sf::Http();
+        if (!http.setHost(host, port))
+        {
+            Fail(MusicDownloadError::ConnectionFailed);
+            return;
+        }
+
+        const auto remoteDir = std::filesystem::path(base) / RemoteDirectory;
+        const auto encode    = [](const std::filesystem::path& path)
+        {
+            return "/" + path.generic_string();
+        };
+
+        const auto getRemoteSize = [&](const std::string& name) -> std::optional<std::uint64_t>
+        {
+            const auto request  = sf::Http::Request(encode(remoteDir / name), sf::Http::Request::Method::Head);
+            const auto response = http.sendRequest(request, TransferTimeout);
+            if (response.getStatus() != sf::Http::Response::Status::Ok)
+                return std::nullopt;
+
+            try
+            {
+                return static_cast<std::uint64_t>(std::stoull(response.getField("Content-Length")));
+            }
+            catch (...)
+            {
+                return std::nullopt;
+            }
+        };
+
+        auto queue = std::vector<std::vector<FileEntry>>();
+        std::uint64_t totalSize = 0;
+        for (const auto& item : items)
+        {
+            const auto ojn = GetTempFileName(item.MusicID, item.Version) + ".ojn";
+            const auto ojm = GetTempFileName(item.MusicID, 0) + ".ojm";
+
+            const auto ojnSize = getRemoteSize(ojn);
+            const auto ojmSize = getRemoteSize(ojm);
+            if (!ojnSize.has_value() || !ojmSize.has_value())
+            {
+                Fail(MusicDownloadError::ConnectionFailed);
+                return;
+            }
+
+            totalSize += *ojnSize + *ojmSize;
+            queue.push_back({{ojn, *ojnSize, 0}, {ojm, *ojmSize, 0}});
+        }
+
+        auto error = std::error_code();
+        if (const auto space = std::filesystem::space(".", error); !error && space.available < totalSize)
+        {
+            Fail(MusicDownloadError::InsufficientDiskSpace);
+            return;
+        }
+
+        {
+            auto lock = std::lock_guard(m_mutex);
+            m_progress.Status    = MusicDownloadStatus::Downloading;
+            m_progress.TotalSize = totalSize;
+        }
+
+        std::filesystem::create_directories(TempDirectory, error);
+
+        for (std::size_t index = 0; index < items.size(); index++)
+        {
+            const auto& item    = items[index];
+            auto&       entries = queue[index];
+            const auto  iniPath = std::filesystem::path(TempDirectory) / (GetTempFileName(item.MusicID, item.Version) + ".ini");
+
+            {
+                auto lock = std::lock_guard(m_mutex);
+                m_progress.QueueIndex = index;
+                m_progress.MusicID    = item.MusicID;
+                m_progress.MusicTitle = item.Title;
+                m_notifications.push_back({Notification::Type::DownloadStarted, item.MusicID, MusicDownloadError::None});
+            }
+
+            WriteFileInfo(iniPath, entries);
+
+            auto failure = std::optional<MusicDownloadError>();
+            for (auto& entry : entries)
+            {
+                const auto tempPath  = std::filesystem::path(TempDirectory) / (entry.Name + "_");
+                const auto localPath = std::filesystem::path(MusicDirectory) / entry.Name;
+
+                if (m_cancelled)
+                {
+                    failure = MusicDownloadError::Cancelled;
+                    break;
+                }
+
+                // Already installed with the expected size: nothing to transfer.
+                auto matchError = std::error_code();
+                if (std::filesystem::is_regular_file(localPath, matchError) &&
+                    std::filesystem::file_size(localPath, matchError) == entry.Size && !matchError)
+                {
+                    entry.Status = 4;
+                    WriteFileInfo(iniPath, entries);
+
+                    auto lock = std::lock_guard(m_mutex);
+                    m_progress.FileBytesRead   = entry.Size;
+                    m_progress.TotalBytesRead += entry.Size;
+                    continue;
+                }
+
+                entry.Status = 0;
+                WriteFileInfo(iniPath, entries);
+                std::filesystem::remove(tempPath, error);
+
+                {
+                    auto lock = std::lock_guard(m_mutex);
+                    m_progress.FileName       = entry.Name;
+                    m_progress.FileSize       = entry.Size;
+                    m_progress.FileBytesRead  = 0;
+                }
+
+                const auto request  = sf::Http::Request(encode(remoteDir / entry.Name), sf::Http::Request::Method::Get);
+                const auto clock    = sf::Clock();
+                const auto response = http.sendRequest(request, TransferTimeout);
+
+                bool success = false;
+                if (response.getStatus() == sf::Http::Response::Status::Ok)
+                {
+                    const auto& body = response.getBody();
+                    if (auto file = std::ofstream(tempPath, std::ios::binary | std::ios::trunc))
+                    {
+                        file.write(body.data(), static_cast<std::streamsize>(body.size()));
+                        success = file.good() && !m_cancelled && body.size() == entry.Size;
+                    }
+
+                    const auto elapsed = std::max(clock.getElapsedTime().asSeconds(), 0.001f);
+                    auto lock = std::lock_guard(m_mutex);
+                    m_progress.BytesPerSecond = static_cast<std::uint64_t>(body.size() / elapsed);
+                }
+
+                if (!success)
+                {
+                    failure = MusicDownloadError::DownloadFailed;
+                    break;
+                }
+
+                entry.Status = 4;
+                WriteFileInfo(iniPath, entries);
+
+                {
+                    auto lock = std::lock_guard(m_mutex);
+                    m_progress.FileBytesRead   = entry.Size;
+                    m_progress.TotalBytesRead += entry.Size;
+                }
+            }
+
+            if (failure.has_value())
+            {
+                for (const auto& entry : entries)
+                {
+                    auto cleanupError = std::error_code();
+                    std::filesystem::remove(std::filesystem::path(TempDirectory) / (entry.Name + "_"), cleanupError);
+                    std::filesystem::remove(std::filesystem::path(TempDirectory) / entry.Name, cleanupError);
+                }
+
+                std::filesystem::remove(iniPath, error);
+                std::filesystem::remove(TempDirectory, error);
+
+                Fail(*failure);
+                return;
+            }
+
+            {
+                auto lock = std::lock_guard(m_mutex);
+                m_notifications.push_back({Notification::Type::Renaming, item.MusicID, MusicDownloadError::None});
+            }
+
+            for (const auto& entry : entries)
+            {
+                const auto tempPath  = std::filesystem::path(TempDirectory) / (entry.Name + "_");
+                const auto localPath = std::filesystem::path(MusicDirectory) / entry.Name;
+
+                auto moveError = std::error_code();
+                if (std::filesystem::exists(localPath, moveError))
+                    std::filesystem::remove(tempPath, moveError);
+                else
+                    std::filesystem::rename(tempPath, localPath, moveError);
+            }
+
+            std::filesystem::remove(iniPath, error);
+
+            {
+                auto lock = std::lock_guard(m_mutex);
+                m_notifications.push_back({Notification::Type::DownloadCompleted, item.MusicID, MusicDownloadError::None});
+            }
+        }
+
+        std::filesystem::remove(TempDirectory, error);
+
+        {
+            auto lock = std::lock_guard(m_mutex);
+            m_queue.clear();
+            m_progress = MusicDownloadProgress();
+            m_progress.Status = MusicDownloadStatus::Completed;
+            m_notifications.push_back({Notification::Type::QueueCompleted, 0, MusicDownloadError::None});
+        }
+
+        m_cancelled = false;
+        m_running   = false;
+    }
 }
